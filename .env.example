# Public URL of the deployed site. Enables canonical URLs, hreflang, Open Graph URLs,
# sitemap.xml, RSS and absolute JSON-LD links. Leave empty until you own a domain.
SITE_URL=

# Set to 1 to emit links ending in /index.html so the build also opens from disk (file://).
FILE_LINKS=

# Alternative output directory (default: dist).
OUT_DIR=
